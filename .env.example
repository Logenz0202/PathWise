# PathWise Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API Key (optional - app works in demo mode without it)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Database: a SQLite file, created on first start (default: backend/pathwise.db).
# docker-compose sets its own path; set this only to put the file somewhere else.
# DATABASE_URL=sqlite:///path/to/pathwise.db

# OpenRouter Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Free models tried in order when the main one is busy (JSON list)
OPENROUTER_FALLBACK_MODELS=["google/gemma-4-31b-it:free", "nvidia/nemotron-3.5-super-vl:free"]

# Road routing (OpenStreetMap data, free, no key). Leave empty to use straight-line estimates instead.
OSRM_URL=https://router.project-osrm.org

# App Settings
APP_NAME=PathWise
DEBUG=true